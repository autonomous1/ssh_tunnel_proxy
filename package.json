{
  "name": "ssh_tunnel_proxy",
  "version": "3.0.0",
  "description": "Programmatic local and reverse TCP port forwarding over SSH for Node.js, built for outbound-only and constrained-device deployments.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "proto",
    "examples",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf build",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "npm run build && mocha --timeout 20000 test/**/*.test.js",
    "test:unit": "npm run build && mocha --timeout 5000 test/unit/*.test.js",
    "test:integration": "npm run build && mocha --timeout 20000 test/integration/*.test.js"
  },
  "keywords": [
    "ssh",
    "ssh2",
    "tunnel",
    "ssh-tunnel",
    "reverse-tunnel",
    "reverse-ssh",
    "port-forwarding",
    "tcp-proxy",
    "nat-traversal",
    "zrok",
    "termux",
    "iot",
    "edge",
    "nodejs"
  ],
  "author": "Autonomous",
  "license": "MIT",
  "dependencies": {
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ssh2": "^1.15.0",
    "mocha": "^10.4.0",
    "typescript": "^5.4.0"
  }
}
